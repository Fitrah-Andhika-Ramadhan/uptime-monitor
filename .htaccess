DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # honeypot traps -> middleware logging
  RewriteRule ^(wp-login\.php|wp-admin|wp-content|wp-includes|xmlrpc\.php|setup-config|admin|cfg|dump|backup|adminer|phpmyadmin|pma|config\.php|\.env)$ index.php [L]

  # block public access to sensitive project paths (app code, data, cron, config)
  RewriteRule ^(app|data|cron)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.example\.php|DEPLOY-GIT\.txt)$ - [F,L]
</IfModule>

<FilesMatch "\.(sqlite|sqlite3|db)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
